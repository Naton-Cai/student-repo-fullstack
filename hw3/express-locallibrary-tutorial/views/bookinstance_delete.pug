extends layout

block content
  h1 #{title}

  p #[strong Book:] #[a(href=bookinstance.book.url) #{bookinstance.book.title}]
  p #[strong Imprint:] #{bookinstance.imprint}
  p #[strong Status:] #{bookinstance.status}

  p Do you really want to delete this copy?

  form(method='POST')
    button.btn.btn-primary(type='submit') Delete